# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json
# The Web build's equivalent: webApp/firebase-web-config.json holds the `firebaseConfig` object
# the Firebase console hands out for the web app, and is rendered into the generated
# firebase-init.js at build time. CI supplies it through the FIREBASE_WEB_CONFIG secret instead.
firebase-web-config.json

# Android Profiling
*.hprof

# Kotlin Multiplatform
.kotlin/
*.klib

# iOS
# iosApp/iosApp.xcodeproj (incl. its shared xcshareddata/xcschemes) is committed intentionally so
# CI can build it headlessly - only the per-user caches below are ignored.
*.xcworkspace
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.moved-aside
DerivedData
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
Pods/
Podfile.lock

# macOS
.DS_Store
